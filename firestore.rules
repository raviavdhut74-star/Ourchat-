rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isMember() {
      return request.auth != null
        && request.auth.token.email in [
          'raviavdhut@gmail.com',
          'sheryabhosle@gmail.com'
        ];
    }

    match /messages/{messageId} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isMember();
      // edit own message text, or pin/unpin any message
      allow update: if isMember() && (
        (resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'edited']))
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned'])
      );
    }

    match /calls/{document=**} {
      allow read, write: if isMember();
    }

    match /presence/{uid} {
      allow read: if isMember();
      allow write: if isMember() && request.auth.uid == uid;
    }

    match /snapViews/{id} {
      allow read, create: if isMember();
    }

    match /reactions/{id} {
      allow read: if isMember();
      allow create, update: if isMember()
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isMember()
        && resource.data.uid == request.auth.uid;
    }

    match /stories/{id} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isMember()
        && resource.data.uid == request.auth.uid;
    }

    match /reels/{id} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isMember()
        && resource.data.uid == request.auth.uid;
    }

    match /reelLikes/{id} {
      allow read: if isMember();
      allow create, update: if isMember()
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isMember()
        && resource.data.uid == request.auth.uid;
    }

    match /posts/{id} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isMember()
        && resource.data.uid == request.auth.uid;
    }

    match /comments/{id} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isMember()
        && resource.data.uid == request.auth.uid;
    }

  }
}
